#!/usr/bin/env python3
"""Dev shim: run cozyloop straight from a checkout without installing it.

`pipx install cozy-loop-kit` (or `pip install .`) is the real entry point and
does not use this file — it wires up `cozyloop` from pyproject's [project.scripts].
This exists so an existing `ln -s .../cozy-loop-kit/cozyloop` on PATH keeps working.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "src"))
from cozyloop.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
